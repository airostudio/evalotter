# EvalOtter environment. Copy to .env.local and fill in.
#   cp .env.example .env.local
#
# .env*.local is gitignored. Never commit real values — a service key was
# committed to this repo once already and had to be replaced.

# ── Supabase ────────────────────────────────────────────────────────────
# Project URL, e.g. https://<project-ref>.supabase.co
# Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase is retiring the legacy JWT anon/service_role keys (they can no
# longer be rotated, and are deprecated at the end of 2026). Use the new
# keys from Dashboard → Settings → API Keys → "Publishable and secret API
# keys". Both formats work with the installed @supabase/supabase-js.
#
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  ← the sb_publishable_… key
#   SUPABASE_SERVICE_ROLE_KEY      ← the sb_secret_… key
#
# NEXT_PUBLIC_* is inlined into the client bundle AT BUILD TIME, so changing
# it in a hosting dashboard does nothing until you rebuild. Supabase
# answering "Unregistered API key" (401) almost always means a stale build
# is still presenting a key that has since been deactivated.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses every RLS policy — never expose to the browser and
# never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (optional) ───────────────────────────────────────────────────────
# Enables result interpretation and Palmistry vision analysis. Without it
# both degrade quietly: scores are still calculated deterministically and
# nothing errors, there is simply no written interpretation.
ANTHROPIC_API_KEY=

# ── Stripe (optional, required for paid reports) ────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Perfect Love integration (optional) ─────────────────────────────────
# Shared secret for the server-to-server code redemption endpoint.
PERFECT_LOVE_API_SECRET=

# ── Admin ──────────────────────────────────────────────────────────────
# Comma-separated addresses promoted to admin on sign-in. Solves the
# bootstrap problem: without it, the first admin can only be created by
# editing profiles.role in the database by hand. It never demotes anyone and
# never overrides a super admin; ongoing role changes belong in /admin/users,
# where they are written to the audit log.
ADMIN_EMAILS=

# ── Site ────────────────────────────────────────────────────────────────
# Absolute base URL, used for Stripe redirects. e.g. https://www.evalotter.com
NEXT_PUBLIC_SITE_URL=
