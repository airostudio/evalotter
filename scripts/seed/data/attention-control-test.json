{
  "slug": "attention-control-test",
  "title": "Attention Control Test",
  "shortDescription": "Sustained focus and selective attention under distraction — a flanker-style interference task.",
  "longDescription": "Attention Control Test is built on the Eriksen Flanker Task (Eriksen & Eriksen, 1974) — one of the most widely used paradigms for measuring selective attention and response inhibition. You identify the direction of a center arrow while ignoring surrounding \"flanker\" arrows that sometimes point the same way (congruent, easy) and sometimes point the opposite way (incongruent, harder) — the classic interference effect. Both accuracy and response speed are scored, since the point of the task is resisting the flankers' pull quickly, not just eventually getting it right.",
  "icon": "eye",
  "categoryKey": "cognitive",
  "engineType": "timed_questionnaire",
  "difficulty": "medium",
  "estimatedDurationMinutes": 10,
  "access": "free",
  "sourceNote": "Original flanker trials implementing the Eriksen Flanker Task's published paradigm (a center target flanked by congruent or incongruent distractors, response speed and accuracy both scored) — rendered as plain-text arrow strings rather than Stroop's colored-word format (the catalogue originally described this as \"Stroop-style\"), since flanker trials are genuinely renderable as text/unicode with no image pipeline needed, while an authentic Stroop task needs real colored-text rendering this platform doesn't have yet. Scoring uses timed_choice's response-time weighting (src/lib/scoring/engine.ts) — each question's 3-second time limit is deliberately tight, matching the task's speed-under-interference design; a correct answer given instantly scores full credit, decaying to a 50% floor at the time limit, never to zero (it was still correct).",
  "runnerSettings": {
    "totalTimeLimitSeconds": 600
  },
  "sections": [
    {
      "key": "flanker-trials",
      "name": "Flanker Trials",
      "description": "Identify the direction of the CENTER arrow only, ignoring the arrows around it.",
      "instructions": "Answer as fast as you accurately can. The center arrow is what matters — the surrounding arrows are distractors and sometimes point the other way on purpose.",
      "timeLimitSeconds": null,
      "weight": 1,
      "order": 1
    }
  ],
