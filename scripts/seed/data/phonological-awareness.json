{
  "slug": "phonological-awareness",
  "title": "Phonological Awareness",
  "shortDescription": "Rhyme, syllable, and sound-manipulation tasks measuring how you perceive and work with the sounds of language.",
  "longDescription": "Phonological Awareness is built around the subtest structure of the CTOPP-2 (Comprehensive Test of Phonological Processing, Second Edition — the standard clinical/educational measure of phonological processing): Elision (removing a sound from a spoken word to form another word), Blending Words (synthesizing separate sounds into a word), and Sound Matching (identifying shared initial or final sounds). The CTOPP-2 is administered orally; since this platform has no audio-recording input, every item is adapted to a text/reading format — see the source note below.",
  "icon": "volume-2",
  "categoryKey": "language",
  "engineType": "standard_questionnaire",
  "difficulty": "medium",
  "estimatedDurationMinutes": 12,
  "access": "free",
  "sourceNote": "Original items written to implement the CTOPP-2's published subtest structure (Elision, Blending Words, Sound Matching) — the CTOPP-2 itself is a copyrighted, commercially normed instrument (PRO-ED), so its actual stimulus words and norms are not reproduced here. Known adaptation: the real CTOPP-2 is administered by a clinician reading sounds aloud and recording a spoken response; without audio infrastructure, every item here is presented and answered as text (e.g. 'say cat without the /k/ sound' as a written prompt with multiple-choice answers) rather than a true auditory task. That measures phonemic manipulation ability but not auditory perception specifically — worth building a real audio version if TTS/audio-recording is ever added.",

  "sections": [
    { "key": "elision", "name": "Elision", "description": "Removing a sound from a spoken word to form a different, real word.", "instructions": "Each item names a word and a sound to remove. Choose what's left after removing it.", "timeLimitSeconds": null, "weight": 0.34, "order": 1 },
    { "key": "blending", "name": "Blending Words", "description": "Synthesizing individual sounds into a whole word.", "instructions": "Each item gives you separate sounds. Choose the word they form when blended together.", "timeLimitSeconds": null, "weight": 0.33, "order": 2 },
    { "key": "sound-matching", "name": "Sound Matching", "description": "Identifying which word shares an initial or final sound with a target word.", "instructions": "Choose the word that starts (or ends) with the same sound as the target word.", "timeLimitSeconds": null, "weight": 0.33, "order": 3 }
  ],

  "scoringDimensions": [
    { "key": "phonological-awareness", "label": "Phonological Awareness", "description": "Composite score across elision, blending, and sound matching.", "contributesToBrainProfile": true, "brainProfileDimensionKey": "verbal", "order": 1 },
    { "key": "elision", "label": "Elision", "description": "Ability to remove a phonological segment from a word.", "contributesToBrainProfile": false, "order": 2 },
    { "key": "blending", "label": "Blending", "description": "Ability to synthesize separate sounds into a word.", "contributesToBrainProfile": false, "order": 3 },
    { "key": "sound-matching", "label": "Sound Matching", "description": "Ability to identify shared initial/final sounds across words.", "contributesToBrainProfile": false, "order": 4 }
  ],

  "scoringRules": [
    { "dimensionKey": "phonological-awareness", "formula": "average" },
    { "dimensionKey": "elision", "formula": "sum", "normalization": { "min": 0, "max": 8 } },
    { "dimensionKey": "blending", "formula": "sum", "normalization": { "min": 0, "max": 8 } },
    { "dimensionKey": "sound-matching", "formula": "sum", "normalization": { "min": 0, "max": 8 } }
  ],

  "resultRanges": [
    { "dimensionKey": "overall", "minScore": 0, "maxScore": 30, "title": "Developing", "description": "Sound-manipulation skills are still forming — breaking words into their component sounds and recombining them takes deliberate effort.", "recommendations": ["Practice saying words slowly, sound by sound, before trying to remove or blend a sound", "Start with elision on simple one-syllable words before moving to blends and clusters", "Read aloud regularly — hearing your own pronunciation reinforces the sound-to-letter mapping"], "order": 1 },
    { "dimensionKey": "overall", "minScore": 31, "maxScore": 50, "title": "Average", "description": "Comfortable with simple sound manipulation, but multi-sound blends and less common sound-matching pairs slow you down.", "recommendations": ["Practice blending 3-4 separate sounds into words without seeing them written first", "Work on sound matching across less obvious pairs (matching endings, not just starts)"], "order": 2 },
    { "dimensionKey": "overall", "minScore": 51, "maxScore": 70, "title": "Strong", "description": "Reliable phonemic manipulation across elision, blending, and matching, with occasional slips on trickier consonant clusters.", "recommendations": ["Challenge yourself with elision on words with consonant blends (e.g. removing one sound from a three-consonant cluster)", "Practice with multisyllabic words rather than just single syllables"], "order": 3 },
    { "dimensionKey": "overall", "minScore": 71, "maxScore": 85, "title": "Very Strong", "description": "Fast, accurate sound manipulation across all three skills — this level of phonological awareness underlies strong reading and spelling ability.", "recommendations": ["This skill transfers directly to learning new languages and to spelling irregular words", "Try phonological awareness with unfamiliar or invented words to test the skill in isolation from memorized vocabulary"], "order": 4 },
    { "dimensionKey": "overall", "minScore": 86, "maxScore": 100, "title": "Exceptional", "description": "Expert-level phonological processing — sounds are manipulated automatically and accurately across every task type.", "recommendations": ["Consider how this strength could support tutoring, speech-language work, or language learning", "This is a strong predictor of ease learning additional languages — a good time to try one"], "order": 5 }
  ],

